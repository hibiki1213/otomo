{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Otomo",
  "version": "0.1.2",
  "identifier": "io.github.hibiki1213.otomo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Otomo",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 28 },
        "hiddenTitle": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "copyright": "Copyright © 2026 Hibiki Kawabe",
    "license": "MIT",
    "shortDescription": "Open-source music making with your Claude subscription",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 170, "y": 150 },
        "applicationFolderPosition": { "x": 490, "y": 150 }
      }
    },
    "externalBin": [
      "binaries/otomo-mcp"
    ],
    "resources": {
      "resources/GeneralUser.sf2": "GeneralUser.sf2",
      "resources/GeneralUser-LICENSE.txt": "GeneralUser-LICENSE.txt",
      "resources/THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRDJEOEJCNzg4NEIxNDYKUldSR3NZUjR1OWpTWEFrQnVRSzZLem9maEJWSVhoazFZWHIzUkYxem1wU0FtcG0xdnVjdS9MRmEK",
      "endpoints": [
        "https://github.com/hibiki1213/otomo/releases/latest/download/latest.json"
      ]
    }
  }
}
