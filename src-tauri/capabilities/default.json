{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir"
  ]
}
